# Runtime state and audit artifacts (see DESIGN.md section 3.6)
state.json
journal.db
screen_results*.csv
screen_results_archive/
munger.log
pnl.json

# Generated static report (report.py) -- regenerated from screen_results.csv
# and journal.db, not a permanent artifact
report/

# Raw per-ticker provider response cache (see DESIGN.md section 3.2) --
# a debugging aid overwritten each run, not a permanent artifact.
data_cache/

# Manual intervention flag (see DESIGN.md section 5)
KILL_SWITCH

# Local-only review-gate bookkeeping: this marker is keyed to a commit SHA,
# so committing it would always invalidate the value just written. See the
# comment in .claude/hooks/check-code-push-review.sh.
.claude/review-markers/code-push-staff-engineer.sha

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Test/tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
