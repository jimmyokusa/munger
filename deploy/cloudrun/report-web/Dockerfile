# Cloud Run web service serving the report/ directory generated by the
# daily-screen Cloud Run Job. Unlike report.Dockerfile (which bakes a local
# report/ snapshot into the image at build time for local viewing), this
# image bakes in NO content -- report/ is expected to arrive at runtime via
# a GCS FUSE volume mount (Cloud Run's --add-volume=type=cloud-storage),
# the same bucket the daily-screen job writes to via MUNGER_DATA_DIR.
# Rebuilding this image is only needed for nginx config changes, never for
# new report content.
FROM nginx:alpine

# Cloud Run injects $PORT (default 8080) and expects the container to
# listen on it; nginx doesn't template env vars into its config natively,
# so hardcode 8080 and deploy with --port=8080 to match, rather than
# pulling in gettext/envsubst for a single fixed value.
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
